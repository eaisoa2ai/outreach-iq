# Copy this file to .env and fill in the values you need.
# Nothing here is required to run the demo: OUTREACHIQ works fully offline
# with mock voice/email providers and needs only OPENAI_API_KEY to let the
# agents reason and write text.

# --- Required for the LLM agents (Insight / Decision / Email) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Provider selection ---
# "mock" runs entirely offline: simulated calls + emails written to ./outbox
# Switch to a real backend once you have credentials for it.
VOICE_PROVIDER=mock          # mock | elevenlabs
EMAIL_PROVIDER=mock          # mock | gmail

# --- Only needed when VOICE_PROVIDER=elevenlabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# --- Only needed when EMAIL_PROVIDER=gmail ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
SENDER_EMAIL=outreach@yourdomain.com

# --- Misc ---
DEFAULT_COUNTRY_CODE=+1
DATABASE_URL=sqlite:///./outreachiq.sqlite

# --- Demo control for the mock voice provider ---
# Force every simulated call to a specific outcome instead of the
# deterministic-per-phone-number default. One of:
# completed | failed | did_not_pick
MOCK_CALL_OUTCOME=
